<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Capture Moments — Photographe</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#0A0A0A;--white:#F5F5F5;--muted:#8A8A8A;}
*{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Inter',sans-serif;background:var(--bg);color:var(--white);}
.wrap{max-width:900px;margin:auto;padding:0 22px;}
header{padding:24px 0;display:flex;justify-content:space-between;align-items:center;}
.brand{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:18px;letter-spacing:-.02em;}
nav a{color:var(--muted);margin-left:20px;font-size:13px;text-decoration:none;}
.hero{padding:60px 0 40px;}
h1{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(32px,7vw,58px);line-height:1;letter-spacing:-.02em;}
.hero p{color:var(--muted);margin-top:16px;max-width:380px;font-size:14.5px;}
.btn{display:inline-block;margin-top:24px;border:1px solid var(--white);color:var(--white);padding:12px 24px;font-size:13px;text-decoration:none;}
.gallery{padding:30px 0 50px;display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
.shot{aspect-ratio:4/5;background:#161616;display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.06em;}
.shot:nth-child(2){aspect-ratio:4/6;background:#1c1c1c;}
footer{text-align:center;padding:34px 0;color:var(--muted);font-size:12px;border-top:1px solid #1c1c1c;}
@media(max-width:640px){.gallery{grid-template-columns:repeat(2,1fr);}}
</style>
</head>
<body>
<header><div class="wrap" style="display:flex;justify-content:space-between;width:100%;"><div class="brand">CAPTURE MOMENTS</div><nav><a href="#">Portfolio</a><a href="#">Contact</a></nav></div></header>
<section class="hero"><div class="wrap">
